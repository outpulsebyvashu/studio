# Copy to .env.local. Placeholders only. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Random 32+ character string used when hashing OTP codes.
OTP_PEPPER=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# StartMessaging (check their docs for the exact URL and body)
STARTMESSAGING_API_URL=
STARTMESSAGING_API_KEY=
# Public site address, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000
